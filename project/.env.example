# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# App Configuration
REACT_APP_APP_NAME=Transport Data Management System
REACT_APP_VERSION=1.0.0

# Environment
REACT_APP_ENVIRONMENT=development

# Optional: API timeout settings
REACT_APP_API_TIMEOUT=30000

# Optional: File upload settings
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Optional: Pagination defaults
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100